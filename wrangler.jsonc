{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloudflare-mcp-server",
  "main": "src/index.tsx",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.txt"],
      "fallthrough": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
